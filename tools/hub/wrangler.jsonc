{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./public",
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "toolsbay.app", "custom_domain": true },
    { "pattern": "www.toolsbay.app", "custom_domain": true },
  ],
}
